# Obligraph Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=obligraph-dev-secret-key-change-in-prod-2026

# Database
DATABASE_PATH=obligraph.db

# LLM Configuration
# Set MOCK_LLM=true to run completely offline with realistic deterministic responses
MOCK_LLM=true
LLM_PROVIDER=gemini
# LLM_PROVIDER can be 'gemini' or 'claude'
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Engine Default Parameters
RISK_THRESHOLD_HIGH=70.0
RISK_THRESHOLD_MEDIUM=35.0
DISPUTE_WINDOW_HOURS=48

# Trust Weights
WEIGHT_SELF_REPORTED=0.4
WEIGHT_COUNTERPARTY_CONFIRMED=0.7
WEIGHT_INDEPENDENTLY_VERIFIABLE=1.0

# Risk Weights (w1 + w2 + w3 = 1.0)
RISK_WEIGHT_DEVIATION=0.45
RISK_WEIGHT_UNTRUSTED=0.25
RISK_WEIGHT_DEADLINE=0.30

# IMAP Email Connector (optional)
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Google Sheets Connector (optional)
GOOGLE_SHEET_CSV_URL=
