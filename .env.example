# OBLIGRAPH Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env

# Flask Environment & Security
FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-64-char-secret-key

# Database Configuration
# Leave DATABASE_URL blank locally to use SQLite (obligraph.db).
# In production (Render), set DATABASE_URL to your PostgreSQL connection string:
#   postgresql://user:password@host:5432/obligraph
DATABASE_URL=
DATABASE_PATH=obligraph.db

# LLM Extraction & NL-to-SQL Settings
# Set MOCK_LLM=true (production default) to run 100% offline/deterministically without API keys.
# Set MOCK_LLM=false and provide an API key to use live Gemini or Anthropic Claude extraction.
MOCK_LLM=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional External Evidence Connectors
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
GOOGLE_SHEET_CSV_URL=
